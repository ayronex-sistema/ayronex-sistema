# Obrigatórios para o Basic Auth da rota /checklist
FISCAL_USER_EMAIL=fiscal@ayronex.com.br
FISCAL_USER_PASSWORD=troque-esta-senha
# Quando "true", o checklist fica aberto sem Basic Auth para visualizacao temporaria.
CHECKLIST_PUBLIC_MODE=false

# Opcional: nome exibido quando o fiscal envia o checklist
FISCAL_USER_NAME=Fiscal Ayronex

# Google Sheets API
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"seu-projeto","private_key_id":"chave","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"service-account@project.iam.gserviceaccount.com","client_id":"123456789","token_uri":"https://oauth2.googleapis.com/token"}
# Alternativa: use email + private key separados se preferir
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CHECKLIST_SPREADSHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHECKLIST_SUMMARY_SHEET=Checklist
CHECKLIST_ITEMS_SHEET=Checklist_Itens
